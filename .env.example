# ─────────────────────────────────────────────────────────────────────────────
# Chronix Edu — API service (apps/api). Copy to apps/api/.env for local dev.
# The API refuses to start if a REQUIRED value is missing (src/config/env.ts,
# src/index.ts). Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database / Supabase ─────────────────────────────── REQUIRED
DATABASE_URL=                 # Supabase *session pooler* connection string (table owner — bypasses RLS)
SUPABASE_URL=                 # https://<project>.supabase.co
SUPABASE_PUBLISHABLE_KEY=     # used server-side only for signInWithPassword
SUPABASE_SERVICE_ROLE_KEY=    # server only — never in apps/web, never logged
SUPABASE_STORAGE_BUCKET=school-assets
PG_POOL_MAX=10                # optional

# ── Auth ────────────────────────────────────────────── REQUIRED
JWT_SECRET=                   # >= 32 random chars; signs all app + support-session tokens
ROOT_ADMIN_EMAIL=             # the one account allowed to manage other super_admins and wipe school data

# ── HTTP ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development          # development | test | production
CORS_ORIGIN=                  # web origin, e.g. https://edu.chronixtechnology.com
APP_URL=                      # web origin used in emails / redirects
HEALTH_CHECK_TOKEN=           # optional; required header for GET /health (GET /health/ping stays public)

# ── Redis (rate limiting, lockout, token blacklist) ─────────────────────────
REDIS_URL=                    # REQUIRED in production and whenever >1 replica runs

# ── Email (SendGrid) ────────────────────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@chronixedu.com   # required when SENDGRID_API_KEY is set
SENDGRID_FROM_NAME=Chronix Edu

# ── SMS (Termii) — platform fallback; schools set their own key in settings ─
TERMII_API_KEY=
TERMII_SENDER_ID=ChronixEdu

# ── Payments (Paystack) ─────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=

# ── Observability ───────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Super admin / support ───────────────────────────────────────────────────
SUPER_ADMIN_PASSWORD=         # only read by `npm run seed:superadmin`
SUPPORT_SESSION_MAX_DURATION_HOURS=2

# ── Dev/test only — never set in production ─────────────────────────────────
SEED_SECRET=                  # enables POST /api/auth/seed-test-user when NODE_ENV != production
TEST_DATABASE_URL=            # npm run test:db — must be a LOCAL db whose name ends in _test
