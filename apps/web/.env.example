# Chronix Edu — web service (apps/web). Copy to apps/web/.env.local for local dev.
# NEXT_PUBLIC_* values are baked into the browser bundle — never put secrets here.
# The web app no longer uses Supabase directly (AUDIT H-9): do NOT set
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.

NEXT_PUBLIC_API_URL=          # REQUIRED in production, e.g. https://chronixeduapi-production.up.railway.app
NEXT_PUBLIC_APP_URL=          # public web origin
NEXT_PUBLIC_SENTRY_DSN=
